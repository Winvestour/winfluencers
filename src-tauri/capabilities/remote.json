{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-winvestour-window",
  "description": "Canli winvestour.com sayfasina YALNIZ pencere-kontrol izinleri (ozel baslik cubugu: surukle/kucult/buyut/kapat). Baska hicbir Tauri API'si uzak icerige acik degil.",
  "remote": {
    "urls": ["https://www.winvestour.com", "https://winvestour.com"]
  },
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-hide"
  ]
}
